    - rid: 3758369457129652781
      type: {class: DialogueCommand, ns: UGESystem, asm: Assembly-CSharp}
      data:
        <CommandType>k__BackingField: 0
        _isNodeExpanded: 0
        _dialogueText: "\uCEE4\uD53C\uC20D\uC5D0\uB294 \uC794\uC794\uD55C \uC74C\uC545\uC774
          \uD750\uB974\uACE0 \uD5A5\uAE0B\uD55C \uCEE4\uD53C\uD5A5\uC774 \uAC10\uB3CC\uC558\uB2E4.
          \n\uBE48\uD2F0\uC9C0\uD55C \uAC00\uAD6C\uC5D0 \uAC00\uC815\uC9D1 \uAC19\uC740
          \uC778\uD14C\uB9AC\uC5B4\uC758 \uD3B8\uC548\uD568\uC744 \uB290\uB084 \uC218
          \uC788\uB294 \uACF3\uC774\uC5C8\uB2E4."
        _characterName: 
        _expression: 
        _characterPosition: 0
        _clearAllCharacters: 0
        _showCharacter: 0
        _cinematicAnimDuration: 0
        _cinematicDisplayDuration: 0
    - rid: 3758369457129652782
      type: {class: DialogueCommand, ns: UGESystem, asm: Assembly-CSharp}
      data:
        <CommandType>k__BackingField: 0
        _isNodeExpanded: 0
        _dialogueText: "\uC640~ \uC774\uACF3 \uC815\uACA8\uC6B4 \uB290\uB08C\uC774
          \uC815\uB9D0 \uC88B\uC740\uB370\uC694? \uC5C6\uB358 \uCD94\uC5B5\uB3C4
          \uC0DD\uAE38\uAC83 \uAC19\uC544\uC694. \uC660\uC9C0 \uADF8\uB9AC\uC6B4
          \uB290\uB08C\uC774\uC5D0\uC694."
        _characterName: aad29799-f6ee-42af-96bd-0d09cdc990ae
        _expression: Default
        _characterPosition: 0
        _clearAllCharacters: 0
        _showCharacter: 0
        _cinematicAnimDuration: 0
        _cinematicDisplayDuration: 0
    - rid: 3758369457129652783
      type: {class: DialogueCommand, ns: UGESystem, asm: Assembly-CSharp}
      data:
        <CommandType>k__BackingField: 0
        _isNodeExpanded: 0
        _dialogueText: "\u2026 \uB9D8\uC5D0 \uB4DC\uC2E0\uAC83\uAC19\uC544 \uB2E4\uD589\uC774\uB124\uC694.
