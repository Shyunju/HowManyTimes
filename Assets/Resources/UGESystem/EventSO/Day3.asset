      data:
        <CommandType>k__BackingField: 0
        _isNodeExpanded: 0
        _dialogueText: "\uB9D0\uC500\uD574\uC8FC\uC2E0\uB300\uB85C \uC1FC\uD551\uC744
          \uD558\uB7EC \uB098\uAC14\uC5C8\uC2B5\uB2C8\uB2E4. \uC0DD\uD544\uD488\uB3C4
